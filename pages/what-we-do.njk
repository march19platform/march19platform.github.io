<div class="container">
{# Our Projects #}
<section class="section">
  <h2 class="section-title">
    <svg class="section-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/></svg>
    Our Projects
  </h2>
  <div class="grid grid-3">
    {% for project in collections.projects %}
    <a href="{{ project.data.externalUrl or project.url }}"{% if project.data.externalUrl %} target="_blank" rel="noopener"{% endif %} class="card card-link">
      <img src="{{ project.data.thumbnail }}" alt="{{ project.data.title }}" class="card-thumbnail">
      <h3 class="card-title">{{ project.data.title }}</h3>
      <p class="card-description">{{ project.data.description }}</p>
    </a>
    {% endfor %}
    <a href="/fanzins/" class="card card-link">
      <img src="/assets/projects/project3.jpg" alt="Weekly Mini Newspaper" class="card-thumbnail">
      <h3 class="card-title">Weekly Mini Newspaper aka "Fanzin"</h3>
      <p class="card-description">We write a mini weekly newspaper in English to make sure you're up to date. Trust us, we know it's not easy</p>
    </a>
  </div>
</section>

{# Our Collaborations #}
<section class="section">
  <h2 class="section-title">
    <svg class="section-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
    Our Collaborations
  </h2>

  {# Aile Dayanışma Ağı (ADA) #}
  <div class="org-featured">
    <div class="org-featured-info">
      <h3 class="org-featured-name">Aile Dayanışma Ağı (ADA)</h3>
      <p class="org-featured-description">
        The Family Solidarity Network (Aile Dayanışma Ağı) is a voluntary grassroots initiative in Türkiye, organized by the families of individuals detained or imprisoned in political and legal operations. Under the leadership and advocacy of Dilek İmamoğlu, the Network provides a platform for mutual support, collective advocacy, and public visibility for families navigating challenging legal circumstances.
      </p>
      <p class="org-featured-description">
        Through weekly solidarity gatherings, public events, and community outreach, Aile Dayanışma Ağı amplifies the voices of affected families, promotes transparency in the justice system, and fosters solidarity among communities facing shared struggles. The initiative has drawn attention and support from civil society and political actors, reflecting broader discussions about justice, rights, and the legal process in Türkiye.
      </p>
      <a href="/org/ada/" class="read-more-link">Read more details &rarr;</a>
    </div>
    <div class="org-featured-image">
      <a href="/org/ada/">
        <img src="/assets/ada/ada-news-current.jpg" alt="ADA Newsletter" class="ada-featured-img">
      </a>
    </div>
  </div>
</section>


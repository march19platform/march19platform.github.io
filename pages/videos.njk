---
layout: layouts/list.njk
title: Videos
description: Panel discussions, interviews, and community events
permalink: /videos/
---
{% set upcomingVideos = collections.videos | filterUpcoming(true) %}
{% set pastVideos = collections.videos | filterUpcoming(false) %}

{% if upcomingVideos.length > 0 %}
<section class="section">
  <h2>Upcoming</h2>
  <div class="grid grid-2">
  {% for video in upcomingVideos %}
    <div class="card">
      <h3 class="card-title"><a href="{{ video.url }}">{{ video.data.title }}</a></h3>
      <p class="card-meta">{{ video.data.date | dateFormat }}</p>
      <p class="card-description">{{ video.data.description }}</p>
    </div>
  {% endfor %}
  </div>
</section>
{% endif %}

{% if pastVideos.length > 0 %}
<section class="section">
  <h2>Past Videos</h2>
  <div class="grid grid-2">
  {% for video in pastVideos %}
    <div class="card">
      {% if video.data.youtubeId %}
      <div class="video-embed" style="margin-bottom: var(--spacing-sm);">
        <iframe
          src="https://www.youtube.com/embed/{{ video.data.youtubeId }}"
          title="{{ video.data.title }}"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>
      {% endif %}
      <h3 class="card-title"><a href="{{ video.url }}">{{ video.data.title }}</a></h3>
      <p class="card-meta">{{ video.data.date | dateFormat }}</p>
      <p class="card-description">{{ video.data.description }}</p>
    </div>
  {% endfor %}
  </div>
</section>
{% endif %}

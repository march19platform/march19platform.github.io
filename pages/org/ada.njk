<script type="module">
  const newsletters = [
    { date: 'February 20, 2026', url: '/assets/ada/pdfs/ada-2026-02-20.pdf' },
    { date: 'February 13, 2026', url: '/assets/ada/pdfs/ada-2026-02-13.pdf' },
    { date: 'February 6, 2026', url: '/assets/ada/pdfs/ada-2026-02-06.pdf' },
    { date: 'January 27, 2026', url: '/assets/ada/pdfs/ada-2026-01-27.pdf' },
    { date: 'January 16, 2026', url: '/assets/ada/pdfs/ada-2026-01-16.pdf' },
    { date: 'January 9, 2026', url: '/assets/ada/pdfs/ada-2026-01-09.pdf' },
    { date: 'December 31, 2025', url: '/assets/ada/pdfs/ada-2025-12-31.pdf' },
    { date: 'December 26, 2025', url: '/assets/ada/pdfs/ada-2025-12-26.pdf' },
    { date: 'December 19, 2025', url: '/assets/ada/pdfs/ada-2025-12-19.pdf' },
    { date: 'December 5, 2025', url: '/assets/ada/pdfs/ada-2025-12-05.pdf' },
    { date: 'November 21, 2025', url: '/assets/ada/pdfs/ada-2025-11-21.pdf' }
  ];

  const pdfjsLib = await import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.min.mjs');
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.worker.min.mjs';

  const canvas = document.getElementById('ada-newsletter-canvas');
  const context = canvas.getContext('2d');
  const dateEl = document.getElementById('ada-newsletter-date');
  const currentNumEl = document.getElementById('ada-current-num');
  const totalNumEl = document.getElementById('ada-total-num');
  const currentNumTopEl = document.getElementById('ada-current-num-top');
  const totalNumTopEl = document.getElementById('ada-total-num-top');
  const prevBtn = document.getElementById('ada-prev');
  const nextBtn = document.getElementById('ada-next');
  const prevBtnTop = document.getElementById('ada-prev-top');
  const nextBtnTop = document.getElementById('ada-next-top');
  const downloadLink = document.getElementById('ada-download-link');
  const canvasContainer = document.querySelector('.ada-newsletter-canvas-container');

  let currentIndex = 0;
  totalNumEl.textContent = newsletters.length;
  totalNumTopEl.textContent = newsletters.length;

  async function renderNewsletter(index) {
    const newsletter = newsletters[index];
    dateEl.textContent = newsletter.date;
    downloadLink.href = newsletter.url;
    currentNumEl.textContent = index + 1;
    currentNumTopEl.textContent = index + 1;

    const pdf = await pdfjsLib.getDocument(newsletter.url).promise;
    const page = await pdf.getPage(1);

    const containerWidth = canvasContainer.offsetWidth;
    const unscaledViewport = page.getViewport({ scale: 1 });
    const scale = containerWidth / unscaledViewport.width;
    const viewport = page.getViewport({ scale: scale });

    canvas.height = viewport.height;
    canvas.width = viewport.width;

    await page.render({ canvasContext: context, viewport: viewport }).promise;

    const atStart = index <= 0;
    const atEnd = index >= newsletters.length - 1;
    prevBtn.disabled = atStart;
    nextBtn.disabled = atEnd;
    prevBtnTop.disabled = atStart;
    nextBtnTop.disabled = atEnd;
  }

  function goNewer() {
    if (currentIndex > 0) {
      currentIndex--;
      renderNewsletter(currentIndex);
    }
  }

  function goOlder() {
    if (currentIndex < newsletters.length - 1) {
      currentIndex++;
      renderNewsletter(currentIndex);
    }
  }

  prevBtn.addEventListener('click', goNewer);
  nextBtn.addEventListener('click', goOlder);
  prevBtnTop.addEventListener('click', goNewer);
  nextBtnTop.addEventListener('click', goOlder);

  renderNewsletter(0);
</script>

---
<div class="container">
{% set upcomingVideos = collections.videos | filterUpcoming(true) %}

{# Watch Our Latest Panel Discussion #}
<section class="section">
  <h2 class="section-title">
    <svg class="section-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    Watch Our Latest Panel Discussion
  </h2>
  <div class="video-embed">
    <iframe
      src="https://www.youtube.com/embed/ddA3IEbsNNg"
      title="Hacer Foggo - December 14, 2025"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen>
    </iframe>
  </div>
</section>

{# Upcoming Panel Discussions #}
{% if upcomingVideos.length > 0 %}
<section class="section">
  <h2 class="section-title">
    <svg class="section-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
    Upcoming Panel Discussions
  </h2>
  <div class="grid grid-2">
  {% for video in upcomingVideos %}
    <a href="{{ video.url }}" class="panel-poster-link">
      <img src="{{ video.data.poster or '/assets/videos/placeholder-poster.jpg' }}" alt="{{ video.data.title }}" class="panel-poster">
    </a>
  {% endfor %}
  </div>
</section>
{% endif %}


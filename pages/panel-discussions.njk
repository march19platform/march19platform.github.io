---
layout: layouts/base.njk
title: Panel Discussions
permalink: /panel-discussions/
---
<div class="container">
{% set upcomingVideos = collections.videos | filterUpcoming(true) %}
{% set pastVideos = collections.videos | filterUpcoming(false) %}

{# Watch Our Latest Panel Discussion #}
{% if pastVideos.length > 0 %}
{% set latestVideo = pastVideos[0] %}
<section class="section">
  <h2 class="section-title">
    <svg class="section-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    Watch Our Latest Panel Discussion
  </h2>
  <div class="video-embed">
    <iframe
      src="https://www.youtube.com/embed/{{ latestVideo.data.youtubeId }}"
      title="{{ latestVideo.data.title }}"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen>
    </iframe>
  </div>
</section>
{% endif %}

{# Upcoming Panel Discussions #}
{% if upcomingVideos.length > 0 %}
<section class="section">
  <h2 class="section-title">
    <svg class="section-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
    Upcoming Panel Discussions
  </h2>
  <div class="grid grid-2">
  {% for video in upcomingVideos %}
    <a href="{{ video.url }}" class="panel-poster-link">
      <img src="{{ video.data.poster or '/assets/videos/placeholder-poster.jpg' }}" alt="{{ video.data.title }}" class="panel-poster">
    </a>
  {% endfor %}
  </div>
</section>
{% endif %}

{# Past Panel Discussions #}
{% if pastVideos.length > 1 or (pastVideos.length > 0 and not pastVideos[0].data.youtubeId) %}
<section class="section">
  <h2 class="section-title">
    <svg class="section-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg>
    Past Panel Discussions
  </h2>
  <div class="grid grid-2">
  {% for video in pastVideos %}
    {% if loop.index > 1 or not video.data.youtubeId %}
    <a href="{{ video.url }}" class="panel-poster-link">
      <img src="{{ video.data.poster or '/assets/videos/placeholder-poster.jpg' }}" alt="{{ video.data.title }}" class="panel-poster">
    </a>
    {% endif %}
  {% endfor %}
  </div>
</section>
{% endif %}
</div>

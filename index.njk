---
layout: layouts/base.njk
title: Home
---
<div class="container">
  {# Row 1: Latest Fanzin (left) + Upcoming Video (right) #}
  <div class="grid grid-2">
    {# Latest Fanzin #}
    {% if collections.fanzins.length > 0 %}
    {% set latestFanzin = collections.fanzins[0] %}
    <section class="section">
      <h2 class="section-title">Latest Fanzin</h2>
      {% if latestFanzin.data.pdfUrl %}
      <div class="pdf-viewer" id="pdf-container" data-pdf-url="{{ latestFanzin.data.pdfUrl }}">
        <div class="pdf-canvas-container">
          <canvas class="pdf-canvas"></canvas>
        </div>
        <div class="pdf-controls">
          <button class="pdf-nav-btn" id="pdf-prev" disabled>&larr; Prev</button>
          <span class="pdf-page-info">Page <span id="pdf-page-num">1</span> of <span id="pdf-page-count">-</span></span>
          <button class="pdf-nav-btn" id="pdf-next">Next &rarr;</button>
        </div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    {# Upcoming Video #}
    {% set upcomingVideos = collections.videos | filterUpcoming(true) %}
    {% if upcomingVideos.length > 0 %}
    {% set nextVideo = upcomingVideos[0] %}
    <section class="section">
      <h2 class="section-title">Upcoming Panel Discussion</h2>
      {% if nextVideo.data.poster %}
      <a href="{{ nextVideo.url }}">
        <img src="{{ nextVideo.data.poster }}" alt="{{ nextVideo.data.title }}" class="card-poster" style="border-radius: 4px;">
      </a>
      {% endif %}
    </section>
    {% endif %}
  </div>

  {# Row 2: Most Recent Video (full span) #}
  {% set recentVideos = collections.videos | filterUpcoming(false) %}
  {% if recentVideos.length > 0 %}
  {% set latestVideo = recentVideos[0] %}
  <section class="section">
    <h2 class="section-title">Watch Recent Panel Discussion</h2>
    <div class="video-embed">
      <iframe
        src="https://www.youtube.com/embed/{{ latestVideo.data.youtubeId }}"
        title="{{ latestVideo.data.title }}"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen>
      </iframe>
    </div>
  </section>
  {% endif %}

  {# Row 3: Our Projects (3 thumbnails) #}
  <section class="section">
    <h2 class="section-title">Our Projects</h2>
    <div class="grid grid-3">
      {% for project in collections.projects | limit(2) %}
      <a href="{{ project.url }}" class="card card-link">
        <img src="{{ project.data.thumbnail }}" alt="{{ project.data.title }}" class="card-thumbnail">
        <h3 class="card-title">{{ project.data.title }}</h3>
        <p class="card-description">{{ project.data.description }}</p>
      </a>
      {% endfor %}
      <a href="/fanzins/" class="card card-link">
        <img src="/assets/projects/project3.jpg" alt="Weekly Mini Newspaper" class="card-thumbnail">
        <h3 class="card-title">Weekly Mini Newspaper aka "Fanzin"</h3>
        <p class="card-description">We write a mini weekly newspaper in English to make sure you're up to date. Trust us, we know it's not easy</p>
      </a>
    </div>
  </section>

  {# Row 4: Supported Campaigns (3 thumbnails) #}
  {% if collections.campaigns.length > 0 %}
  <section class="section">
    <h2 class="section-title">Campaigns We Support</h2>
    <div class="grid grid-3">
      {% for campaign in collections.campaigns | limit(3) %}
      <a href="{{ campaign.url }}">
        <img src="{{ campaign.data.thumbnail }}" alt="{{ campaign.data.title }}" class="campaign-image">
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>

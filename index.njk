<script type="module">
  const spreadViewers = document.querySelectorAll('.spread-viewer');
  if (spreadViewers.length > 0) {
    const pdfjsLib = await import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.min.mjs');
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.worker.min.mjs';

    async function setupSpreadViewer(viewer) {
      const pdfUrl = viewer.dataset.pdfUrl;
      const pdf = await pdfjsLib.getDocument(pdfUrl).promise;
      const totalPages = pdf.numPages;
      const canvasLeft = viewer.querySelector('.spread-canvas-left');
      const canvasRight = viewer.querySelector('.spread-canvas-right');
      const pageInfo = viewer.querySelector('.spread-page-info');
      const pageCount = viewer.querySelector('.spread-page-count');
      const prevBtn = viewer.querySelector('.spread-prev');
      const nextBtn = viewer.querySelector('.spread-next');
      let currentSpread = 0;

      pageCount.textContent = totalPages;

      async function renderPage(canvas, pageNum) {
        if (pageNum > totalPages) {
          canvas.style.display = 'none';
          return;
        }
        canvas.style.display = 'block';
        const page = await pdf.getPage(pageNum);
        const container = canvas.parentElement;
        const containerWidth = container.offsetWidth;
        const unscaledViewport = page.getViewport({ scale: 1 });
        const scale = containerWidth / unscaledViewport.width;
        const viewport = page.getViewport({ scale });
        canvas.height = viewport.height;
        canvas.width = viewport.width;
        await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
      }

      async function renderSpread(spreadIndex) {
        const leftPage = spreadIndex * 2 + 1;
        const rightPage = spreadIndex * 2 + 2;
        await Promise.all([renderPage(canvasLeft, leftPage), renderPage(canvasRight, rightPage)]);
        if (rightPage <= totalPages) {
          pageInfo.textContent = leftPage + '-' + rightPage;
        } else {
          pageInfo.textContent = leftPage;
        }
        prevBtn.disabled = spreadIndex <= 0;
        nextBtn.disabled = rightPage >= totalPages;
      }

      prevBtn.addEventListener('click', () => { if (currentSpread > 0) { currentSpread--; renderSpread(currentSpread); } });
      nextBtn.addEventListener('click', () => { if ((currentSpread + 1) * 2 < totalPages) { currentSpread++; renderSpread(currentSpread); } });
      renderSpread(0);
    }

    spreadViewers.forEach(setupSpreadViewer);
  }
</script>

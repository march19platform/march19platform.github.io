      <a href="https://open.spotify.com/show/6M7JEfkANqxKDzzSbckDwS?si=55044d14a8824239" target="_blank" rel="noopener" class="connect-link">
        <svg class="connect-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
        <span>Listen to our Podcasts on Spotify (Demokrasi Nöbeti)</span>
      </a>
      <a href="https://march19platform.us11.list-manage.com/subscribe?u=c9bb8750eec033913bd270dbe&id=c0071b7816&f_id=0023afe1f0" target="_blank" rel="noopener" class="connect-link">
        <svg class="connect-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        <span>Subscribe to our e-mail newsletter</span>
      </a>
    </div>
  </section>

  {# Row 1: Latest Fanzin (left) + Upcoming Video (right) #}
  <div class="grid grid-2">
    {# Latest Fanzin #}
    {% if collections.fanzins.length > 0 %}
    {% set latestFanzin = collections.fanzins[0] %}
    <section class="section">
      <h2 class="section-title">Latest Fanzin</h2>
      {% if latestFanzin.data.pdfUrl %}
      <div class="pdf-viewer" id="pdf-container" data-pdf-url="{{ latestFanzin.data.pdfUrl }}">
        <div class="pdf-canvas-container">
          <canvas class="pdf-canvas"></canvas>
        </div>
        <div class="pdf-controls">
          <button class="pdf-nav-btn" id="pdf-prev" disabled>&larr; Prev</button>
          <span class="pdf-page-info">Page <span id="pdf-page-num">1</span> of <span id="pdf-page-count">-</span></span>
          <button class="pdf-nav-btn" id="pdf-next">Next &rarr;</button>
        </div>
      </div>
      {% endif %}
    </section>
    {% endif %}

    {# Upcoming Video #}
    {% set upcomingVideos = collections.videos | filterUpcoming(true) %}
    {% if upcomingVideos.length > 0 %}
    {% set nextVideo = upcomingVideos[0] %}
    <section class="section">
      <h2 class="section-title">Upcoming Panel Discussion</h2>
      {% if nextVideo.data.poster %}
      <a href="{{ nextVideo.url }}">
        <img src="{{ nextVideo.data.poster }}" alt="{{ nextVideo.data.title }}" class="card-poster" style="border-radius: 4px;">
      </a>
      {% endif %}
    </section>
    {% endif %}
  </div>

  {# Row 2: Most Recent Video (full span) #}
  {% set recentVideos = collections.videos | filterUpcoming(false) %}
  {% if recentVideos.length > 0 %}
  {% set latestVideo = recentVideos[0] %}
  <section class="section">
    <h2 class="section-title">Watch Latest Panel Discussion</h2>
    <div class="video-embed">
      <iframe
        src="https://www.youtube.com/embed/{{ latestVideo.data.youtubeId }}"
        title="{{ latestVideo.data.title }}"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen>
      </iframe>
    </div>
  </section>
  {% endif %}

  {# Spotify Podcast #}
  <section class="section">
    <h2 class="section-title">Listen Latest Spotify Episode</h2>
    <iframe style="border-radius:12px" src="https://open.spotify.com/embed/show/6M7JEfkANqxKDzzSbckDwS?utm_source=generator&theme=0" width="100%" height="352" frameBorder="0" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
  </section>

  {# Row 3: Our Projects (3 thumbnails) #}
  <section class="section">
    <h2 class="section-title">Our Projects</h2>
    <div class="grid grid-3">
      {% for project in collections.projects | limit(2) %}
      <a href="{{ project.url }}" class="card card-link">
        <img src="{{ project.data.thumbnail }}" alt="{{ project.data.title }}" class="card-thumbnail">
        <h3 class="card-title">{{ project.data.title }}</h3>
        <p class="card-description">{{ project.data.description }}</p>
      </a>
      {% endfor %}
      <a href="/fanzins/" class="card card-link">
        <img src="/assets/projects/project3.jpg" alt="Weekly Mini Newspaper" class="card-thumbnail">
        <h3 class="card-title">Weekly Mini Newspaper aka "Fanzin"</h3>
        <p class="card-description">We write a mini weekly newspaper in English to make sure you're up to date. Trust us, we know it's not easy</p>
      </a>
    </div>
  </section>

  {# Row 4: Supported Campaigns (3 thumbnails) #}
  {% if collections.campaigns.length > 0 %}
  <section class="section">
    <h2 class="section-title">Campaigns We Support</h2>
    <div class="grid grid-3">
      {% for campaign in collections.campaigns | limit(3) %}
      <a href="{{ campaign.url }}">
        <img src="{{ campaign.data.thumbnail }}" alt="{{ campaign.data.title }}" class="campaign-image">
      </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>

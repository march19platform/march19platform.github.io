<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-branding">
      <img src="/assets/images/march19platform_logo.png" alt="March 19 Platform" class="site-logo">
      <div class="site-branding-text">
        <span class="site-title">March 19 Platform</span>
        <span class="site-slogan">United for Democracy in Türkiye</span>
      </div>
    </a>
    <nav class="site-nav">
      <ul>
        <li><a href="/"{% if page.url == "/" %} class="active"{% endif %}>Home</a></li>
        <li><a href="/about/"{% if page.url == "/about/" %} class="active"{% endif %}>About</a></li>
        <li><a href="/panel-discussions/"{% if page.url.startsWith("/panel-discussions/") %} class="active"{% endif %}>Panel Discussions</a></li>
        <li><a href="/fanzins/"{% if page.url.startsWith("/fanzins/") %} class="active"{% endif %}>Fanzin</a></li>
        <li><a href="/projects/"{% if page.url.startsWith("/projects/") %} class="active"{% endif %}>Projects</a></li>
        <li><a href="/campaigns/"{% if page.url.startsWith("/campaigns/") %} class="active"{% endif %}>Campaigns</a></li>
        <li><a href="/contact/"{% if page.url == "/contact/" %} class="active"{% endif %}>Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

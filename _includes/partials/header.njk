<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-branding">
      <img src="/assets/images/march19platform_logo.png" alt="March 19 Platform" class="site-logo">
      <div class="site-branding-text">
        <span class="site-title">March 19 Platform</span>
        <span class="site-slogan">United for Democracy in Türkiye</span>
      </div>
    </a>
    <nav class="site-nav">
      <ul>
        <li><a href="/"{% if page.url == "/" %} class="active"{% endif %}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
          Home
        </a></li>
        <li><a href="/panel-discussions/"{% if page.url.startsWith("/panel-discussions/") %} class="active"{% endif %}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          Panel Discussions
        </a></li>
        <li><a href="/fanzins/"{% if page.url.startsWith("/fanzins/") %} class="active"{% endif %}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
          Fanzins
        </a></li>
        <li><a href="/what-we-do/"{% if page.url.startsWith("/what-we-do/") or page.url.startsWith("/projects/") or page.url.startsWith("/campaigns/") %} class="active"{% endif %}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          What We Do
        </a></li>
        <li><a href="/about/"{% if page.url == "/about/" %} class="active"{% endif %}>
          <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          About Us
        </a></li>
      </ul>
    </nav>
  </div>
</header>
